{
  "name": "aws",
  "version": "0.1.0",
  "bin": {
    "aws": "bin/aws.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:frontend": "npx tsx scripts/deploy-frontend.ts",
    "deploy:frontend:dry": "npx tsx scripts/deploy-frontend.ts --dry-run",
    "deploy:frontend:skip-build": "npx tsx scripts/deploy-frontend.ts --skip-build",
    "seed:generate": "npx tsx scripts/auth/seed-guests.ts --generate",
    "seed:dry": "npx tsx scripts/auth/seed-guests.ts --dry-run",
    "seed": "npx tsx scripts/auth/seed-guests.ts",
    "seed:list": "npx tsx scripts/auth/seed-guests.ts --list"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/node": "22.7.9",
    "aws-cdk": "2.1030.0",
    "aws-sdk-client-mock": "^4.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.975.0",
    "@aws-sdk/client-cloudfront": "^3.975.0",
    "@aws-sdk/client-dynamodb": "^3.975.0",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/client-secrets-manager": "^3.975.0",
    "@aws-sdk/lib-dynamodb": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@types/aws-lambda": "^8.10.160",
    "aws-cdk-lib": "2.215.0",
    "constructs": "^10.0.0",
    "dotenv": "^17.2.3",
    "jose": "^6.1.3",
    "mime-types": "^2.1.35"
  }
}
